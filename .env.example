# Public DNS name used by the Nginx TLS template.
DAMAGE_GUI_DOMAIN=damage.example.com

# Optional image tag used by docker compose.
DAMAGE_GUI_IMAGE=damagelab-web:2.1.0

# Leave empty to use the first discovered model.  If set, startup fails when
# this model ID is not present in the mounted model volume.
DAMAGE_GUI_DEFAULT_MODEL=

# Managed result retention; valid range is 1..3650 days.
DAMAGE_GUI_RESULT_RETENTION_DAYS=7

# Compose sets these container paths.  Override only when using custom mounts.
DAMAGE_GUI_HOME=/var/lib/damagelab
DAMAGE_GUI_DB=/var/lib/damagelab/db/damage_gui.db
DAMAGE_GUI_MODEL_DIR=/var/lib/damagelab/models
DAMAGE_GUI_RESULT_DIR=/var/lib/damagelab/results
DAMAGE_GUI_HOST=0.0.0.0
DAMAGE_GUI_PORT=8000

# Optional legacy-compatible data directory for truth lookup/metrics.
# DAMAGE_GUI_DATA_DIR=/var/lib/damagelab/data

# Required: generate with python -c 'import secrets; print(secrets.token_urlsafe(32))'
DAMAGE_GUI_API_TOKEN=
# Stop admitting compute requests once managed results reach this byte threshold.
DAMAGE_GUI_MAX_RESULT_BYTES=1073741824

# Offline/desktop model signing key; Compose uses its private database volume.
# DAMAGE_GUI_MODEL_KEY_FILE=/private/model-signing.key

# Shared-workspace compute admission per minute (positive integer).
DAMAGE_GUI_RATE_LIMIT=60

# Synchronous compute concurrency; use 1 on small-memory hosts.
DAMAGE_GUI_MAX_COMPUTE=2

# Retained model bundles; use 1 on small-memory hosts.
DAMAGE_GUI_MODEL_CACHE_SIZE=2
